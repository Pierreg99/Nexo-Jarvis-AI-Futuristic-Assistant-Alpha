# The assistant works without credentials. Copy this file to .env for local development.
PORT=3000
NEXO_DATA_DIR=.nexo-data

# Optional open-ended conversation; never use VITE_ variables for API keys.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# NEXO_AI_MODEL=gpt-4.1-mini

# Default: AI requires an authenticated user. Enable only for a trusted personal server.
# NEXO_AI_ALLOW_GUESTS=true

# Optional existing Manus provider/auth configuration:
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=
# JWT_SECRET=
# DATABASE_URL=

# Root deployment is the default. GitHub Pages CI sets the repository prefix.
# VITE_BASE_PATH=/Nexo-Jarvis-AI-Futuristic-Assistant-Alpha/

# Natural speech output (server only; never put these keys in VITE_ variables).
# OpenAI can reuse OPENAI_API_KEY, or use a separate speech key:
# OPENAI_TTS_API_KEY=
# OPENAI_TTS_BASE_URL=https://api.openai.com/v1
# NEXO_TTS_MODEL=gpt-4o-mini-tts
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_NAME=My natural voice
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Natural speech requires sign-in by default. Private evaluation servers only:
# NEXO_VOICE_ALLOW_GUESTS=false

# Google/Microsoft account sign-in and server workspace sync.
# Generate a random secret of at least 32 bytes; keep it stable across restarts.
# NEXO_SESSION_SECRET=
# NEXO_PUBLIC_URL=https://nexo.example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
